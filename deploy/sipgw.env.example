# WiFi Secure Call SIP gateway configuration.
#
# Copy to /opt/wifi-secure-call/config/sipgw.env, fill every value in, and
# chmod 0600. The file is read by systemd, never by the binary's command line,
# so passwords do not appear in `ps`.

# The host name devices use as their SIP domain and in their REGISTER URI.
SIPGW_DOMAIN=sip.example.com

# Digest realm. Defaults to SIPGW_DOMAIN when empty.
SIPGW_REALM=

# Listeners. Set a listener to an empty value to disable it.
SIPGW_LISTEN_UDP=0.0.0.0:5060
SIPGW_LISTEN_TLS=0.0.0.0:5061
SIPGW_LISTEN_WSS=

# Certificate for the TLS and WSS listeners. Let's Encrypt certificates from the
# host's certbot installation work; the service must be able to read them.
SIPGW_TLS_CERT=/etc/letsencrypt/live/sip.example.com/fullchain.pem
SIPGW_TLS_KEY=/etc/letsencrypt/live/sip.example.com/privkey.pem

# One entry per watch: username:password. Passwords must be at least 8
# characters. Generate them, never reuse an Apple ID password.
SIPGW_USERS=watch1:REPLACE_WITH_A_LONG_RANDOM_PASSWORD,watch2:REPLACE_WITH_ANOTHER_ONE

# Inbound numbers served by the trunk mapped to a local user.
SIPGW_DIDS=+380441234567:watch1

# Signs the digest nonces. 32 random bytes, hex or base64; must not change while
# devices are registered, because every outstanding nonce becomes invalid.
SIPGW_NONCE_SECRET=REPLACE_WITH_32_RANDOM_BYTES

# Upstream SIP provider that terminates calls into the PSTN.
SIPGW_TRUNK_HOST=trunk.provider.example
SIPGW_TRUNK_PORT=5060
SIPGW_TRUNK_TRANSPORT=udp
SIPGW_TRUNK_USER=
SIPGW_TRUNK_PASS=

# RTP relay. "auto" keeps the server on the media path so a watch behind a home
# router can still hear the call; "off" passes SDP through unchanged and only
# works when the watch is directly reachable.
SIPGW_MEDIA_RELAY=auto
SIPGW_MEDIA_BIND=0.0.0.0
SIPGW_MEDIA_PUBLIC_IP=203.0.113.10

# Registration lifetime accepted from devices.
SIPGW_REGISTRATION_TTL=300s

# Status endpoint (health, registrations, Prometheus metrics). Bind it to
# loopback and expose it through nginx if it has to be reachable.
SIPGW_HTTP_ADDR=127.0.0.1:8791

LOG_LEVEL=info
