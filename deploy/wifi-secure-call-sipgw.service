[Unit]
Description=WiFi Secure Call SIP gateway (registrar, signalling proxy, RTP relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wifi-secure-call
Group=wifi-secure-call
EnvironmentFile=/opt/wifi-secure-call/config/sipgw.env
ExecStart=/opt/wifi-secure-call/bin/wifi-secure-call-sipgw
Restart=on-failure
RestartSec=2

# The gateway binds 5060/udp and optionally 5061/tcp, so it cannot live inside
# the socket-activated HTTP unit. It still runs unprivileged: set
# net.ipv4.ip_unprivileged_port_start=0 on the host if a low port is required.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/opt/wifi-secure-call/state
ReadOnlyPaths=/opt/wifi-secure-call/config /opt/wifi-secure-call/secrets
UMask=0077

# Media is forwarded in user space; give the relay enough descriptors for the
# call volume before the default 1024 soft limit becomes the cap.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
